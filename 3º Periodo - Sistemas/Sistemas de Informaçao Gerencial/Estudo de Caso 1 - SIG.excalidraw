    },
    {
      "id": "aRwEU4sfd5WbMcsfn_uJC",
      "type": "text",
      "x": 994.5303048217233,
      "y": -2480.4368146816632,
      "width": 1433.3377685546875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 264214618,
      "version": 1236,
      "versionNonce": 620056293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786207834500,
      "link": null,
      "locked": false,
      "text": "Serviços externos como da Receita Federal, SEFAZ, Gateways podem ocasionar\nproblemas caso fiquem indisponíveis, sendo necessário um sistema próprio de\nemissão de notas fiscais, pagamento, para mitigação dos danos.\nProblemas de comunicação com a Nuvem ou do emissor de alertas podem gerar\natrasos na comunicação entre os setores, sendo necessário a elaboração de um\nsistema próprio de comunicação e alertas para tentar reduzir essa situação.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serviços externos como da Receita Federal, SEFAZ, Gateways podem ocasionar problemas caso fiquem indisponíveis, sendo necessário um sistema próprio de emissão de notas fiscais, pagamento, para mitigação dos danos.\nProblemas de comunicação com a Nuvem ou do emissor de alertas podem gerar atrasos na comunicação entre os setores, sendo necessário a elaboração de um sistema próprio de comunicação e alertas para tentar reduzir essa situação.",
      "autoResize": false,
      "lineHeight": 1.25
    },
