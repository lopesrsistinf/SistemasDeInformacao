      "updated": 1786207122296,
      "link": null,
      "locked": false,
      "text": "Vantagens:\nComunicação em tempo real entre todos os setores\nAtualização de todas as interações em tempo real para a gerencia poder acompanhar\nFacilidade de uso para o cliente\nAutomação do sistema",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vantagens:\nComunicação em tempo real entre todos os setores\nAtualização de todas as interações em tempo real para a gerencia poder acompanhar\nFacilidade de uso para o cliente\nAutomação do sistema",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "08ATwKJAhPa6gzs83KETu",
      "type": "text",
      "x": 1588.334264986111,
      "y": -2544.4369570970275,
