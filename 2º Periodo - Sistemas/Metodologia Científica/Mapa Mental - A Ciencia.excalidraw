    {
      "id": "4bS6Tgpfkd15NjqJbr6zK",
      "type": "text",
      "x": 1418.346093314034,
      "y": -1794.6571816943951,
      "width": 341.2198181152344,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
