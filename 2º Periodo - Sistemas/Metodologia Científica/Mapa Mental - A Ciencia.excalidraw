    {
      "id": "VaDwja72ieLIl6uyNvR2w",
      "type": "text",
      "x": 681.189367748442,
      "y": 5.759376889183386,
      "width": 792.1994018554688,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
