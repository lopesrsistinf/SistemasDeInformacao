    },
    {
      "id": "MSIb4ZyPCYbLrro4PnHhm",
      "type": "text",
      "x": -1095.8018043154761,
      "y": -1534.4534999302455,
      "width": 325.259765625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
