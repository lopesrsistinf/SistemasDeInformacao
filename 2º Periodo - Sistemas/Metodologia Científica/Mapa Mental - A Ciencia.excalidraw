    },
    {
      "id": "X4Sncfs-S5e2EsqxVBsL_",
      "type": "text",
      "x": -873.2546851748509,
      "y": -1141.2467331659218,
      "width": 327.6998291015625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 291416513,
      "version": 758,
      "versionNonce": 1842460150,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775160486602,
      "link": null,
      "locked": false,
      "text": "É o caso de Demo (1985: 31), que\ndistingue a ideologia como forma\nde conhecimento composta de\nenunciados que justificam\nrelações de poder.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hitfMogkNJ8peI0ZL-TzV",
      "originalText": "É o caso de Demo (1985: 31), que distingue a ideologia como forma de conhecimento composta de enunciados que justificam relações de poder.",
      "autoResize": true,
      "lineHeight": 1.25
    },
