    },
    {
      "id": "YH1TSLrJvgNDyDbWU1mJe",
      "type": "text",
      "x": 744.7227539789105,
      "y": -559.5736207507915,
      "width": 618.7996215820312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1T",
      "roundness": null,
      "seed": 1638668330,
      "version": 682,
      "versionNonce": 81274602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775164214944,
      "link": null,
      "locked": false,
      "text": "Esse desenvolvimento do conhecimento científico, e a busca por\ncontrole da natureza, gerou grandes avanços como: lançadeira\n(1733), o tear mecânico (1738), a máquina a vapor (1768), a\nlocomotiva (1813), o barco a vapor (1821) e muitos outros.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "dOP6cMfWvt9RiEZF2_XZ8",
      "originalText": "Esse desenvolvimento do conhecimento científico, e a busca por controle da natureza, gerou grandes avanços como: lançadeira (1733), o tear mecânico (1738), a máquina a vapor (1768), a locomotiva (1813), o barco a vapor (1821) e muitos outros.",
      "autoResize": true,
      "lineHeight": 1.25
    },
