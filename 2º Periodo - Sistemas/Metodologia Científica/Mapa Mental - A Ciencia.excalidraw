      "index": "b1G",
      "roundness": null,
      "seed": 649181046,
      "version": 722,
      "versionNonce": 981581814,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775163289437,
      "link": null,
      "locked": false,
      "text": "Reconhecido como o pai do método\ncientífico. Enfatizou a atitude\nempírica na pesquisa científica,\nrompendo com as indicações de\nAristóteles, e buscou medir os\nfenômenos e fazer observações\nquantitativas.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "1RQGbcB8unJeTderVXiaP",
      "originalText": "Reconhecido como o pai do método científico. Enfatizou a atitude empírica na pesquisa científica, rompendo com as indicações de Aristóteles, e buscou medir os fenômenos e fazer observações quantitativas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
