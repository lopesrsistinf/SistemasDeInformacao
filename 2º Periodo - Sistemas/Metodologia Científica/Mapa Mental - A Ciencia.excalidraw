    {
      "id": "9_TJsFLCrleTve28rbXY0",
      "type": "text",
      "x": 888.176156180245,
      "y": -1780.6572045825787,
      "width": 396.05975341796875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
