    },
    {
      "id": "8ZCPrGl6bDKOsuittz8O8",
      "type": "text",
      "x": 355.6862880161825,
      "y": -1792.9071702503034,
      "width": 450.5397033691406,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 120285814,
      "version": 1074,
      "versionNonce": 8133686,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775162190201,
      "link": null,
      "locked": false,
      "text": "Em suas obras, propôs a duvida como método:\n\"Se duvido, penso; se penso, existo\". Com isso,\npromoveu um questionamento radical do\nprincipio de autoridade como forma de\nconhecimento, indo contra o conhecimento\nreligioso e o senso comum predominantes na\népoca.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FxNYwj8oYb33HHcnh-jq7",
      "originalText": "Em suas obras, propôs a duvida como método: \"Se duvido, penso; se penso, existo\". Com isso, promoveu um questionamento radical do principio de autoridade como forma de conhecimento, indo contra o conhecimento religioso e o senso comum predominantes na época.",
      "autoResize": true,
      "lineHeight": 1.25
    },
