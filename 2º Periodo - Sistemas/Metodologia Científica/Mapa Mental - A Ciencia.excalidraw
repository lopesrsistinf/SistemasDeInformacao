      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 1004084470,
      "version": 946,
      "versionNonce": 1019741226,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775162987264,
      "link": null,
      "locked": false,
      "text": "Propôs a ciência como um novo órgão, um\nnovo sentido do pensamento. Com ele\nsurge o caráter prometéico, onde a\nciência deixa de ter aquele saber\nmeramente contemplativo, mas passa a\nter um saber instrumental.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "MsJim4CpszXWAgSpv_rDf",
      "originalText": "Propôs a ciência como um novo órgão, um novo sentido do pensamento. Com ele surge o caráter prometéico, onde a ciência deixa de ter aquele saber meramente contemplativo, mas passa a ter um saber instrumental.",
      "autoResize": true,
      "lineHeight": 1.25
    },
