          "type": "arrow"
        }
      ],
      "updated": 1774551501103,
      "link": null,
      "locked": false,
      "text": "Trata-se de uma forma de\nconhecimento adquirido no\ncotidiano, empirico, por\nexcelência, normalmente adquirido\npor meio de experiencia",
      "fontSize": 20.10714285714293,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trata-se de uma forma de conhecimento adquirido no cotidiano, empirico, por excelência, normalmente adquirido por meio de experiencia",
      "autoResize": false,
      "lineHeight": 1.25
    },
