    {
      "id": "uRanaE-aR1VYjajU_OvPx",
      "type": "rectangle",
      "x": -653.0582333519342,
      "y": -1789.2233872186564,
      "width": 377,
      "height": 185,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
