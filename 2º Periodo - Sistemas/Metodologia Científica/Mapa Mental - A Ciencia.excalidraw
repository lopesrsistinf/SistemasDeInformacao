      "versionNonce": 1715436202,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775161564145,
      "link": null,
      "locked": false,
      "text": "Tornou-se necessário dividir o\nconhecimento em diferentes áreas\ncom o tempo, com a justificativa de\nque objetos diferentes reclamam\nconceitos de natureza diferentes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "KSFTV8F3bWKGZqmQC1a2U",
      "originalText": "Tornou-se necessário dividir o conhecimento em diferentes áreas com o tempo, com a justificativa de que objetos diferentes reclamam conceitos de natureza diferentes",
      "autoResize": true,
      "lineHeight": 1.25
