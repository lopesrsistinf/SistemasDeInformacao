      "isDeleted": false,
      "boundElements": null,
      "updated": 1775161562607,
      "link": null,
      "locked": false,
      "text": "A necessidade de compreender melhor o\nmundo na antiguidade e a necessidade de\nprecisão para troca de informações criou\nsistemas mais estruturados de\norganização de conhecimento.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "UfqIJ2KXLJSRdwf-viItJ",
      "originalText": "A necessidade de compreender melhor o mundo na antiguidade e a necessidade de precisão para troca de informações criou sistemas mais estruturados de organização de conhecimento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
